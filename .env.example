# Copy of the variables in LLD-2. Real values come from Secret Manager: `make env` writes a git-ignored .env.
ENV=dev
GCP_PROJECT=
GCP_REGION=asia-south1
CLOUDSQL_INSTANCE=<project>:asia-south1:mcs-dev
DATABASE_URL=postgresql+psycopg://mcs:<secret>@127.0.0.1:5432/mcs
DATABASE_URL_RO=postgresql+psycopg://mcs_ro:<secret>@127.0.0.1:5432/mcs
DATABASE_URL_TEST=postgresql+psycopg://mcs:<secret>@127.0.0.1:5432/mcs_test
NEO4J_URI=neo4j+s://<id>.databases.neo4j.io
NEO4J_USER=<id>
NEO4J_PASSWORD=
NEO4J_DATABASE=<id>
NEO4J_RO_USER=
NEO4J_RO_PASSWORD=
PROVIDER=vertex
MODEL_FAST=gemini-3.1-flash-lite
MODEL_STRONG=gemini-3.1-flash-lite
FALLBACK_PROVIDER=
MODEL_FALLBACK=
EMBED_PROVIDER=
EMBED_MODEL=text-embedding-005
EMBED_DIM=768
EMBED_TIMEOUT_MS=3000
VERTEX_LOCATION=
VERTEX_LLM_LOCATION=global
ANTHROPIC_VIA=vertex
ANTHROPIC_VERTEX_REGION=global
ANTHROPIC_API_KEY=
OPENAI_BASE_URL=
OPENAI_API_KEY=
MAIL_ADAPTER=demo
GMAIL_DELEGATED_USER=
GMAIL_PUBSUB_TOPIC=projects/<project>/topics/mcs-gmail
GMAIL_PUSH_AUDIENCE=
SUPPORT_ADDRESS=support@matsui-demo.example
GCS_BUCKET=mcs-dev-uploads
RETENTION_DAYS=30
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STAFF_ALLOWLIST=
AGENT_API_URL=http://localhost:8000
