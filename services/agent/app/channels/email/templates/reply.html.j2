<!doctype html>
<html lang="en"><body style="margin:0;background:#f4f6f9;font-family:Arial,Helvetica,sans-serif;color:#1b2733">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr><td align="center" style="padding:16px">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;background:#ffffff">
<tr><td style="background:#0a2540;color:#ffffff;padding:16px 24px;font-size:18px;font-weight:bold">Matsui Customer Care</td></tr>
<tr><td style="padding:24px;font-size:14px;line-height:1.5">
<p>Dear {{ name }},</p>
<p>Thank you for contacting Matsui.</p>
{% for b in blocks %}
{% if b.kind == 'heading' %}<h3 style="color:#0057a8;font-size:15px;margin:20px 0 6px">{{ b.text }}</h3>
{% elif b.kind == 'p' %}<p>{{ b.text }}</p>
{% else %}<{{ b.kind }}>{% for i in b['items'] %}<li>{{ i }}</li>{% endfor %}</{{ b.kind }}>
{% endif %}
{% endfor %}
{% if notes %}<p style="font-size:12px;color:#52606d;border-top:1px solid #d9e2ec;padding-top:8px">{% for n in notes %}[{{ loop.index }}] {{ n }}<br>{% endfor %}</p>{% endif %}
{% if ticket %}<p><strong>Ticket reference:</strong> {{ ticket }}</p>{% endif %}
<p>Matsui Customer Care<br><span style="font-size:12px;color:#52606d">AI-assisted, reviewed when needed</span></p>
</td></tr>
<tr><td style="padding:12px 24px;font-size:11px;color:#7b8794;background:#f4f6f9">Demo system: all data in this message is synthetic.</td></tr>
</table></td></tr></table></body></html>
